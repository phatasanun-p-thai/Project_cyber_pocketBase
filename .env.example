# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าจริง
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# .env ถูก .gitignore ไว้แล้ว ห้าม commit

# port ที่ expose ออกมาที่ host (ผูกกับ 127.0.0.1 เท่านั้น)
POCKETBASE_PORT=8090

# ------------------------------------------------------------- superuser
# สร้าง/อัปเดต account นี้ตอน container start (ดู docker/entrypoint.sh)
# สร้างรหัสยาว >= 12 ตัว และห้ามใช้ค่าตัวอย่างนี้ในระบบจริง
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-to-a-long-random-password

# ----------------------------------------------------------------- mailer
# เว้นว่างไว้ = ปิดการส่งอีเมลแจ้งเตือน (hook จะ log ว่าไม่ได้ตั้งค่า)
# กรอกค่าครบทั้ง 4 บรรทัดถ้าต้องการให้อีเมลเดิน (Gmail ต้องใช้ App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ==================================================================
# ค่าสำหรับ test.http / สคริปต์ทดสอบการโจมตี (ไม่กระทบการรันเซิร์ฟเวอร์)
# ==================================================================

VICTIM_EMAIL=victim@example.com
ATTACKER_EMAIL=attacker@example.com
USER_PASSWORD=ChangeMe123456